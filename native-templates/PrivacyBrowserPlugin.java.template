package __PACKAGE__;

import android.content.Intent;
import android.net.Uri;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;

@CapacitorPlugin(name = "PrivacyBrowser")
public class PrivacyBrowserPlugin extends Plugin {
    @PluginMethod
    public void open(PluginCall call) {
        String rawUrl = call.getString("url");
        if (rawUrl == null || rawUrl.length() > 4096) {
            call.reject("A valid HTTPS URL is required.");
            return;
        }

        Uri uri = Uri.parse(rawUrl);
        if (!"https".equalsIgnoreCase(uri.getScheme()) || uri.getHost() == null || uri.getUserInfo() != null) {
            call.reject("Only HTTPS websites can be opened in Piko Browser.");
            return;
        }

        if (getActivity() == null) {
            call.reject("The app activity is not available.");
            return;
        }

        Intent intent = new Intent(getActivity(), PrivacyBrowserActivity.class);
        intent.putExtra(PrivacyBrowserActivity.EXTRA_URL, uri.toString());
        getActivity().runOnUiThread(() -> {
            try {
                getActivity().startActivity(intent);
                call.resolve();
            } catch (Exception exception) {
                call.reject("Unable to open the browser.", exception);
            }
        });
    }
}
