# Public Supabase project config (these are not secret keys).
SUPABASE_URL=https://fwgmvyzmrggmkedjqdki.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_vTdHEf8J6UTiqhlRz5eAdw_0WRoXo4y

# The agent signs in using the same Piko Beats account that owns your queue.
PC_AGENT_NAME=Windows PC
POLL_INTERVAL_SECONDS=30

# Optional: YouTube Data API v3 key for official playlist-item metadata.
# Restrict this key to YouTube Data API v3 in Google Cloud.
YOUTUBE_DATA_API_KEY=

# Optional Google Drive Desktop OAuth client JSON downloaded from Google Cloud.
GOOGLE_OAUTH_CLIENT_FILE=credentials.json

# Only this local folder is considered for explicit --upload-folder operation.
IMPORT_DIR=%USERPROFILE%\Music\Piko Beats Imports
MAX_UPLOAD_MB=200
MAX_PLAYLIST_ITEMS=250
